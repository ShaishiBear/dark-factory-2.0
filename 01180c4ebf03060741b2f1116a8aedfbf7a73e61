__/VideoExplorer.test.tsx\",\"[derived] app/frontend/src/__tests__/adminApi.test.ts\",\"[derived] app/frontend/src/components/CitationModal.test.tsx\",\"[derived] app/frontend/src/components/Message.test.tsx\",\"[derived] app/frontend/src/components/Sidebar.test.tsx\",\"[derived] app/frontend/src/hooks/useAdminVideos.test.ts\",\"[derived] app/frontend/src/hooks/useConversations.test.ts\",\"[derived] app/frontend/src/lib/exportMarkdown.test.ts\"],\"version\":\"1.0\"}\n"},"context.raw.json":{"sha256":"3a35628cb26cefaf3b86b04223998ad280a5df9911ed171b76107c33de1c9717","text":"{\n  \"version\": \"1.0\",\n  \"contract_sha256\": \"9c913dea3437b5fd99eb88c16d43b0a75296f8196af5b8c8a215e7585b2abdb0\",\n  \"files\": [\n    \"app/frontend/src/components/CitationModal.tsx\",\n    \"app/frontend/src/components/CitationModal.test.tsx\",\n    \"app/frontend/src/lib/api.ts\",\n    \"app/frontend/src/components/ChatArea.tsx\",\n    \"app/frontend/src/__tests__/ChatArea-handleCitationClick.test.tsx\",\n    \"app/frontend/src/components/Message.tsx\",\n    \"app/frontend/src/components/Message.test.tsx\"\n  ],\n  \"symbols\": [\n    \"app/frontend/src/components/CitationModal.tsx#CitationModal\",\n    \"app/frontend/src/lib/api.ts#Citation\",\n    \"app/frontend/src/components/ChatArea.tsx#handleCitationClick\"\n  ],\n  \"callers\": [\n    \"app/frontend/src/components/ChatArea.tsx#handleCitationClick\"\n  ],\n  \"tests\": [\n    \"app/frontend/src/components/CitationModal.test.tsx\",\n    \"app/frontend/src/__tests__/ChatArea-handleCitationClick.test.tsx\",\n    \"app/frontend/src/components/Message.test.tsx\"\n  ],\n  \"invariants\": [\n    \"Kept modal behaviour unchanged: embed URL with start and autoplay params, video title, timestamp range, 'Open on YouTube' external link with t param, Escape-key close, close-button close, backdrop-click close, and body-scroll lock while mounted — the existing unit tests in CitationModal.test.tsx must still pass.\",\n    \"Dynamous citations never open the modal (ChatArea.handleCitationClick opens lesson_url directly, ChatArea.tsx:443-459); citation chips and tooltips in Message.tsx are unchanged.\",\n    \"The snippet is displayed from the Citation payload as supplied — presentation-only change; no backend, ingest, API or schema change, and no client-side truncation or reformatting of snippet content.\",\n    \"The pre-existing unit test 'does not render a transcript snippet section' (CitationModal.test.tsx:35-41) pins the old behaviour AC-1/AC-2 replace and must be rewritten inside the same acceptance-test file during RED; it cannot survive unchanged.\",\n    \"Apart from that rewritten test and the two new AC checkpoints, the remaining tests in CitationModal.test.tsx (kept-behaviour tests and formatTimestamp tests) stay byte-identical; __tests__/ChatArea-handleCitationClick.test.tsx and Message.test.tsx need no change.\",\n    \"Authentication, owner-private conversations and the 25-messages-per-user-per-24-hours limit are untouched; all existing independent proof and permission rules remain mandatory.\"\n  ],\n  \"adrs\": [],\n  \"history\": [\n    \"issue #181 first build (GitHub run 34998691864) failed on the whitespace-matching trap: an exact getByText over multiline text under Testing Library's default normalizer can never match literal newlines, so the AC-2 checkpoint must use a whitespace-preserving normalizer or exact textContent equality with the expected text verbatim.\"\n  ],\n  \"notes\": \"Current CitationModal.tsx (135 lines): backdrop div with role=dialog aria-label 'Video citation' > panel (max-h-[90vh] flex flex-col) > header (video_title, formatTimestamp range, close button aria-label 'Close') > scrollable content column div.flex-1.min-h-0.flex.flex-col.gap-4.mb-4.overflow-y-auto (line 89) containing only the aspect-video iframe block (title 'YouTube video player', fallback 'Video unavailable') > footer with 'Open on YouTube' link. Escape close, body-scroll lock and backdrop close are three useEffects/handlers with dedicated tests. The citation modal is YouTube-only; ChatArea.tsx:443-459 routes Dynamous citations straight to lesson_url/toast and only setSelectedCitation for YouTube, rendering <CitationModal citation={selectedCitation} .../> at ChatArea.tsx:788. Citation type (app/frontend/src/lib/api.ts:46) already carries snippet: string non-optional, so no type or API change is needed. CitationModal.test.tsx has 11 kept-behaviour/modal tests plus 4 formatTimestamp tests; the single contradicting test is lines 35-41 asserting absence of 'Transcript Excerpt' and the snippet. Tailwind class rules are unobservable in jsdom (no stylesheet), so AC-2's pre-wrap must be an inline style to be visible to getComputedStyle. RED-stage expected_failure should quote a short literal fragment of Testing Library's stable error, e.g. 'Unable to find an element with the text', quote-free. No dependencies declared; no ADR in docs/atlas/register/DECISION_REGISTER.md governs frontend component structure.\"\n}\n"},"design.json":{"sha256":"ffe2b7b8721d3ac95afc6e06dc077747784253f9ff4df8b75c08608983644f45","text":"{\"ac_mapping\":{\"AC-1\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"],\"AC-2\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"]},\"allowed_new_files\":[],\"context_sha256\":\"66c814a0925786e21efa18b466bcbadb4414ada7c9fb2c4afd387e57e660f3f0\",\"contract_sha256\":\"9c913dea3437b5fd99eb88c16d43b0a75296f8196af5b8c8a215e7585b2abdb0\",\"data_flows\":[\"Citation.snippet (verbatim, may contain literal newlines) -> CitationModal -> 'Transcript Excerpt' section text block rendered with inline white-space: pre-wrap\",\"ChatArea.selectedCitation (YouTube citations only) -> ChatArea.handleCitationClick -> CitationModal rendered dialog (header, YouTube iframe, Transcript Excerpt section, footer link)\"],\"invariants\":[\"Kept modal behaviour unchanged: embed URL with start and autoplay params, video title, timestamp range, 'Open on YouTube' external link with t param, Escape-key close, close-button close, backdrop-click close, and body-scroll lock while mounted — all existing untouched unit tests in CitationModal.test.tsx must still pass.\",\"Dynamous citations never open the modal (ChatArea.handleCitationClick opens lesson_url directly); citation chips and tooltips in Message.tsx are unchanged.\",\"The snippet is displayed from the Citation payload as supplied — presentation-only; no backend, ingest, API or schema change, and no client-side truncation or reformatting of snippet content.\",\"The pre-existing unit test 'does not render a transcript snippet section' (CitationModal.test.tsx:35-41) is rewritten inside the same acceptance-test file during the RED stage and cannot survive unchanged.\",\"Apart from that rewritten test and the two new AC checkpoints, the remaining tests in CitationModal.test.tsx (kept-behaviour tests and formatTimestamp tests) stay byte-identical; __tests__/ChatArea-handleCitationClick.test.tsx and Message.test.tsx need no change.\",\"Authentication, owner-private conversations and the 25-messages-per-user-per-24-hours limit are untouched; all existing independent proof and permission rules remain mandatory.\"],\"modules\":[\"CitationModal\"],\"planned_files\":[\"app/frontend/src/components/CitationModal.test.tsx\",\"app/frontend/src/components/CitationModal.tsx\"],\"public_interfaces\":[\"CitationModal({ citation: Citation; onClose: () => void }) -> JSX.Element (role=\\\"dialog\\\", aria-label \\\"Video citation\\\")\"],\"seams\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"],\"version\":\"1.0\"}\n"},"design.raw.json":{"sha256":"3fdf87de527b79b623ac4e9a1a146df0bc2898c01ec3f25afdd8daa0e4bd57da","text":"{\n  \"version\": \"1.0\",\n  \"modules\": [\n    \"CitationModal\"\n  ],\n  \"seams\": [\n    \"app/frontend/src/components/CitationModal.tsx#CitationModal\"\n  ],\n  \"public_interfaces\": [\n    \"CitationModal({ citation: Citation; onClose: () => void }) -> JSX.Element (role=\\\"dialog\\\", aria-label \\\"Video citation\\\")\"\n  ],\n  \"invariants\": [\n    \"Kept modal behaviour unchanged: embed URL with start and autoplay params, video title, timestamp range, 'Open on YouTube' external link with t param, Escape-key close, close-button close, backdrop-click close, and body-scroll lock while mounted — all existing untouched unit tests in CitationModal.test.tsx must still pass.\",\n    \"Dynamous citations never open the modal (ChatArea.handleCitationClick opens lesson_url directly); citation chips and tooltips in Message.tsx are unchanged.\",\n    \"The snippet is displayed from the Citation payload as supplied — presentation-only; no backend, ingest, API or schema change, and no client-side truncation or reformatting of snippet content.\",\n    \"The pre-existing unit test 'does not render a transcript snippet section' (CitationModal.test.tsx:35-41) is rewritten inside the same acceptance-test file during the RED stage and cannot survive unchanged.\",\n    \"Apart from that rewritten test and the two new AC checkpoints, the remaining tests in CitationModal.test.tsx (kept-behaviour tests and formatTimestamp tests) stay byte-identical; __tests__/ChatArea-handleCitationClick.test.tsx and Message.test.tsx need no change.\",\n    \"Authentication, owner-private conversations and the 25-messages-per-user-per-24-hours limit are untouched; all existing independent proof and permission rules remain mandatory.\"\n  ],\n  \"data_flows\": [\n    \"Citation.snippet (verbatim, may contain literal newlines) -> CitationModal -> 'Transcript Excerpt' section text block rendered with inline white-space: pre-wrap\",\n    \"ChatArea.selectedCitation (YouTube citations only) -> ChatArea.handleCitationClick -> CitationModal rendered dialog (header, YouTube iframe, Transcript Excerpt section, footer link)\"\n  ],\n  \"ac_mapping\": {\n    \"AC-1\": [\n      \"app/frontend/src/components/CitationModal.tsx#CitationModal\"\n    ],\n    \"AC-2\": [\n      \"app/frontend/src/components/CitationModal.tsx#CitationModal\"\n    ]\n  },\n  \"planned_files\": [\n    \"app/frontend/src/components/CitationModal.tsx\",\n    \"app/frontend/src/components/CitationModal.test.tsx\"\n  ],\n  \"allowed_new_files\": [],\n  \"notes\": \"Design: extend the existing deep module CitationModal.tsx at its current seam — no new component, prop, state, helper or dependency. Inside the existing scrollable content column (CitationModal.tsx:89, div.flex-1.min-h-0.flex.flex-col.gap-4.mb-4.overflow-y-auto), directly after the aspect-video player block, add a 'Transcript Excerpt' section: a heading element with the exact text 'Transcript Excerpt' followed by a text block whose sole content is the React text child {citation.snippet}, carrying inline style { whiteSpace: 'pre-wrap' }. The inline style is required (not a Tailwind class) because class rules have no stylesheet in jsdom and AC-2 asserts computed white-space. Render the section unconditionally for all citations — Citation.snippet is a non-optional string (app/frontend/src/lib/api.ts:46-53), so no new props, guards or empty-state branch are warranted; the component's single rendered dialog seam keeps video parsing, playback, close semantics and now snippet presentation behind one interface. Snippet text must be passed through verbatim: no trim, no collapse, no client-side reformatting. AC-1: 'Transcript Excerpt' section below the video player block, snippet verbatim, iframe (title 'YouTube video player') still present, all inside role=dialog aria-label 'Video citation'. AC-2: with a snippet containing literal newline characters between caption lines, the exact supplied text is matched whitespace-preservingly (exact textContent equality or a no-op normalizer — never the default normalizer, which is this issue's own failed build 34998691864) and getComputedStyle on the carrying element returns whiteSpace 'pre-wrap'. RED stage in CitationModal.test.tsx only: rewrite contradic