{"artifacts":{"architecture-governor.json":{"sha256":"7a9b64858eab2957aed18070a36e6aa880f14a0ea9795e89a9beb6e19e5d9e90","text":"{\"context_sha256\":\"66c814a0925786e21efa18b466bcbadb4414ada7c9fb2c4afd387e57e660f3f0\",\"contract_sha256\":\"9c913dea3437b5fd99eb88c16d43b0a75296f8196af5b8c8a215e7585b2abdb0\",\"convergence\":\"improves\",\"debts\":[\"DEBT-CHAT-AREA\",\"DEBT-SIDEBAR\"],\"decision\":\"proceed\",\"design_sha256\":\"ffe2b7b8721d3ac95afc6e06dc077747784253f9ff4df8b75c08608983644f45\",\"migrations\":[\"MIG-FRONTEND-LARGE-COMPONENTS\"],\"policy_sha256\":\"0db30c9f1e05383df234c84feb31dcef348f09ec605db423606b9f72c7e54add\",\"principles\":[\"ARCH-DEEP-MODULES\",\"ARCH-FRONTEND-BOUNDARIES\"],\"rationale\":[\"Both ACs map to one named seam, app/frontend/src/components/CitationModal.tsx#CitationModal, and are verifiable through the rendered dialog (role=dialog with aria-label 'Video citation', the 'Transcript Excerpt' heading, iframe title 'YouTube video player') without inspecting internals.\",\"Deep-module check passes: the props interface stays {citation, onClose} with no new exported names, parameters, or knobs; snippet rendering is added behind the unchanged interface, widening the existing deep module instead of adding a parallel TranscriptSnippet component or new file (allowed_new_files is correctly empty).\",\"Layer direction holds: CitationModal (frontend-components) already imports Citation from lib/api (frontend-lib), an edge the frontend-components layer allows; the design introduces no new imports, no orchestration in the presentation component, and no cross-layer shortcut.\",\"No-growth debts are untouched: planned_files are CitationModal.tsx and its test file only; ChatArea.tsx and Sidebar.tsx appear solely as context, so DEBT-CHAT-AREA and DEBT-SIDEBAR byte footprints do not change.\",\"MIG-FRONTEND-LARGE-COMPONENTS is not engaged: the design moves no state, networking, or orchestration into ChatArea.tsx or Sidebar.tsx, and CitationModal itself is not a debt hotspot, so its small growth is acceptable.\",\"ARCH-FRONTEND-BOUNDARIES is satisfied by construction: displaying a payload field verbatim in a component is exactly the components layer's role; the contract's presentation-only invariant rules out backend, API, and schema work, so no other layer is implicated.\",\"Multi-ticket horizon: programme part 2 (keyboard focus management) lands on this same CitationModal seam, so extending it now keeps one module per responsibility rather than seeding a parallel modal or snippet module later.\",\"No orphan criteria and no abstraction debt: two ACs, one seam, zero new modules, zero new public interfaces beyond the existing CitationModal signature already listed in the context's public_interfaces.\"],\"required_changes\":[],\"source_files\":[\"app/frontend/src/App.tsx\",\"app/frontend/src/__tests__/ChatArea-handleCitationClick.test.tsx\",\"app/frontend/src/__tests__/ChatArea-refreshConversationsRef.test.tsx\",\"app/frontend/src/__tests__/ChatArea-strictmode-first-send.test.tsx\",\"app/frontend/src/__tests__/VideoExplorer-admin-gate.test.tsx\",\"app/frontend/src/__tests__/VideoExplorer.test.tsx\",\"app/frontend/src/__tests__/adminApi.test.ts\",\"app/frontend/src/components/ChatArea.tsx\",\"app/frontend/src/components/CitationModal.test.tsx\",\"app/frontend/src/components/CitationModal.tsx\",\"app/frontend/src/components/Message.test.tsx\",\"app/frontend/src/components/Message.tsx\",\"app/frontend/src/components/Sidebar.test.tsx\",\"app/frontend/src/components/Sidebar.tsx\",\"app/frontend/src/components/VideoExplorer.tsx\",\"app/frontend/src/hooks/useAdminVideos.test.ts\",\"app/frontend/src/hooks/useAdminVideos.ts\",\"app/frontend/src/hooks/useConversations.test.ts\",\"app/frontend/src/hooks/useConversations.ts\",\"app/frontend/src/hooks/useMessages.ts\",\"app/frontend/src/hooks/useStreamingResponse.ts\",\"app/frontend/src/lib/api.ts\",\"app/frontend/src/lib/exportMarkdown.test.ts\",\"app/frontend/src/lib/exportMarkdown.ts\",\"app/frontend/src/pages/AdminVideos.tsx\"],\"version\":\"1.0\"}\n"},"architecture-governor.raw.json":{"sha256":"a35ef4c536f351a83765bbdeab87e3989f9ed1876c3c7fe85e1347a741222765","text":"{\n  \"version\": \"1.0\",\n  \"decision\": \"proceed\",\n  \"convergence\": \"improves\",\n  \"principles\": [\"ARCH-DEEP-MODULES\", \"ARCH-FRONTEND-BOUNDARIES\"],\n  \"migrations\": [\"MIG-FRONTEND-LARGE-COMPONENTS\"],\n  \"debts\": [\"DEBT-CHAT-AREA\", \"DEBT-SIDEBAR\"],\n  \"rationale\": [\n    \"Both ACs map to one named seam, app/frontend/src/components/CitationModal.tsx#CitationModal, and are verifiable through the rendered dialog (role=dialog with aria-label 'Video citation', the 'Transcript Excerpt' heading, iframe title 'YouTube video player') without inspecting internals.\",\n    \"Deep-module check passes: the props interface stays {citation, onClose} with no new exported names, parameters, or knobs; snippet rendering is added behind the unchanged interface, widening the existing deep module instead of adding a parallel TranscriptSnippet component or new file (allowed_new_files is correctly empty).\",\n    \"Layer direction holds: CitationModal (frontend-components) already imports Citation from lib/api (frontend-lib), an edge the frontend-components layer allows; the design introduces no new imports, no orchestration in the presentation component, and no cross-layer shortcut.\",\n    \"No-growth debts are untouched: planned_files are CitationModal.tsx and its test file only; ChatArea.tsx and Sidebar.tsx appear solely as context, so DEBT-CHAT-AREA and DEBT-SIDEBAR byte footprints do not change.\",\n    \"MIG-FRONTEND-LARGE-COMPONENTS is not engaged: the design moves no state, networking, or orchestration into ChatArea.tsx or Sidebar.tsx, and CitationModal itself is not a debt hotspot, so its small growth is acceptable.\",\n    \"ARCH-FRONTEND-BOUNDARIES is satisfied by construction: displaying a payload field verbatim in a component is exactly the components layer's role; the contract's presentation-only invariant rules out backend, API, and schema work, so no other layer is implicated.\",\n    \"Multi-ticket horizon: programme part 2 (keyboard focus management) lands on this same CitationModal seam, so extending it now keeps one module per responsibility rather than seeding a parallel modal or snippet module later.\",\n    \"No orphan criteria and no abstraction debt: two ACs, one seam, zero new modules, zero new public interfaces beyond the existing CitationModal signature already listed in the context's public_interfaces.\"\n  ],\n  \"required_changes\": [],\n  \"notes\": \"Governor review of issue #181 (citation inspection [transcript], programme candidate, second build after run 34998691864 failed on the whitespace-matching trap). Design places the snippet section below the video player in CitationModal's existing scrollable content column with inline white-space: pre-wrap; that inline-style requirement is consistent with the contract's risk note that Tailwind classes are unobservable in jsdom, so AC-2's getComputedStyle assertion has a real observable. The contradicting unit test 'does not render a transcript snippet section' (CitationModal.test.tsx:35-41) is correctly slated for in-file rewrite during RED, and all other kept tests plus __tests__/ChatArea-handleCitationClick.test.tsx and Message.test.tsx stay untouched, which keeps the kept-behaviour invariants (embed URL with start/autoplay, timestamp range, Open on YouTube with t param, Escape/close-button/backdrop close, body-scroll lock) enforceable byte-identically. Dynamous-citation routing stays in ChatArea.handleCitationClick and is untouched. Advisory (non-structural, for the implementer, not a required change): render the snippet from citation.snippet as supplied with no trimming, truncation, or reflow, and keep the AC-2 test matcher whitespace-preserving (exact textContent equality or a no-op normalizer) with the expected text verbatim, since Testing Library's default normalizer collapses newlines. Policy ID sets were recomputed from architecture.json against context.json files and design.json planned_files and match the kernel-computed sets verbatim.\"\n}\n"},"context.enriched.json":{"sha256":"186998427317cdc3dc733741a1cfcc2db8f9fd21b097b9fabd8ff643939c51b6","text":"{\"adrs\":[],\"callers\":[\"app/frontend/src/components/ChatArea.tsx#handleCitationClick\",\"[derived] app/frontend/src/App.tsx\",\"[derived] app/frontend/src/components/ChatArea.tsx\",\"[derived] app/frontend/src/components/CitationModal.tsx\",\"[derived] app/frontend/src/components/Message.tsx\",\"[derived] app/frontend/src/components/Sidebar.tsx\",\"[derived] app/frontend/src/components/VideoExplorer.tsx\",\"[derived] app/frontend/src/hooks/useAdminVideos.ts\",\"[derived] app/frontend/src/hooks/useConversations.ts\",\"[derived] app/frontend/src/hooks/useMessages.ts\",\"[derived] app/frontend/src/hooks/useStreamingResponse.ts\",\"[derived] app/frontend/src/lib/exportMarkdown.ts\",\"[derived] app/frontend/src/pages/AdminVideos.tsx\"],\"contract_sha256\":\"9c913dea3437b5fd99eb88c16d43b0a75296f8196af5b8c8a215e7585b2abdb0\",\"deterministic_impact\":{\"callers\":[\"app/frontend/src/App.tsx\",\"app/frontend/src/components/ChatArea.tsx\",\"app/frontend/src/components/CitationModal.tsx\",\"app/frontend/src/components/Message.tsx\",\"app/frontend/src/components/Sidebar.tsx\",\"app/frontend/src/components/VideoExplorer.tsx\",\"app/frontend/src/hooks/useAdminVideos.ts\",\"app/frontend/src/hooks/useConversations.ts\",\"app/frontend/src/hooks/useMessages.ts\",\"app/frontend/src/hooks/useStreamingResponse.ts\",\"app/frontend/src/lib/exportMarkdown.ts\",\"app/frontend/src/pages/AdminVideos.tsx\"],\"derived_files\":[\"app/frontend/src/App.tsx\",\"app/frontend/src/__tests__/ChatArea-refreshConversationsRef.test.tsx\",\"app/frontend/src/__tests__/ChatArea-strictmode-first-send.test.tsx\",\"app/frontend/src/__tests__/VideoExplorer-admin-gate.test.tsx\",\"app/frontend/src/__tes