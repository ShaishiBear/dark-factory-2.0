frontend/src/components/Message.tsx\",\n    \"app/frontend/src/components/ChatArea.tsx\",\n    \"app/frontend/src/lib/api.ts\",\n    \"app/backend/rag/tools.py\",\n    \"app/backend/db/repository.py\",\n    \"app/backend/ingest/dynamous.py\",\n    \"docs/PROGRAMME_ACTIVATION.md\"\n  ],\n  \"symbols\": [\n    \"app/frontend/src/components/CitationModal.tsx#CitationModal\",\n    \"app/frontend/src/components/CitationModal.tsx#formatTimestamp\",\n    \"app/frontend/src/lib/api.ts#Citation\",\n    \"app/frontend/src/components/ChatArea.tsx#handleCitationClick\",\n    \"app/frontend/src/components/Message.tsx#citationChip\",\n    \"app/frontend/src/components/CitationModal.test.tsx#does not render a transcript snippet section\"\n  ],\n  \"callers\": [\n    \"app/frontend/src/components/ChatArea.tsx#ChatArea\",\n    \"app/frontend/src/components/Message.tsx#citationChip\",\n    \"app/frontend/src/components/Message.tsx#SourceCitations\"\n  ],\n  \"tests\": [\n    \"app/frontend/src/components/CitationModal.test.tsx\"\n  ],\n  \"invariants\": [\n    \"Frontend-only change in CitationModal.tsx; Citation.snippet is already populated end-to-end (api.ts:53 type, rag/tools.py:211 emission, db/repository.py snippet column read/insert) and needs no backend, API, type or state work.\",\n    \"No new external dependencies (issue ban); line-break preservation reuses the codebase's inline whiteSpace:'pre-wrap' idiom (Message.tsx:202), not <br/> splitting.\",\n    \"formatTimestamp keeps its exported signature and location in CitationModal.tsx — Message.tsx imports it (Message.tsx:4) and uses it in citationChip.\",\n    \"Dynamous citations keep routing directly to lesson_url via ChatArea.handleCitationClick (ChatArea.tsx:443-451) and never reach the modal; the modal stays YouTube-only.\",\n    \"Escape keydown, close-button click and backdrop click each fire onClose exactly once per interaction; body scroll is locked (overflow hidden) while the modal is mounted and restored on unmount (CitationModal.tsx:39-53).\",\n    \"Embed src stays youtube.com/embed/<id>?start=<s>&autoplay=1 and 'Open on YouTube' href stays watch?v=<id>&t=<s>s; the Video-unavailable fallback still covers invalid URL, empty v param and relative URL (CitationModal.tsx:21-36, 91-103; existing tests pin all three).\",\n    \"Empty or whitespace-only snippet renders no transcript section, heading or empty box (trim guard, AC-5).\",\n    \"The player iframe (title 'YouTube video player') remains present in the same render whenever a snippet section is shown; the change is additive below the player inside the existing overflow-y-auto content column (CitationModal.tsx:89).\",\n    \"CitationModal.test.tsx:35-41 negative test 'does not render a transcript snippet section' is an expected-RED inversion target authored only by the acceptance worker (RED-hash enforcement refuses implementation-worker commits); all preservation tests (iframe src, external link, Escape, backdrop, close button, scroll lock, Video-unavailable fallbacks, formatTimestamp cases) stay green; unit-test count ratchet only rises (DFE-015 split floor).\",\n    \"Authentication, owner-private conversations and the 25 messages per user per 24 hours limit are untouched; protected lanes (harness/, tests/factory/) untouched; canonical gate afterwards is python harness/ci.py --quick.\",\n    \"No keyboard focus entry/restoration work in this issue (programme item 2, sequenced after); no pre-implementation of the focus follow-up.\"\n  ],\n  \"adrs\": [],\n  \"history\": [\n    \"4b6c1e7 feat(factory): activate approved citation inspection programme (#178)\"\n  ],\n  \"notes\": \"Verified directly in the worktree. CitationModal.tsx renders no snippet today; its scrollable content column (line 89, flex-1 min-h-0 overflow-y-auto) is the host for the new section. The inverted negative test (test lines 35-41) queries the heading text 'Transcript Excerpt' and the snippet text, so the implementation should use that heading label to match the acceptance rewrite. The pre-wrap idiom precedent is Message.tsx:202 (user message span); Message.tsx citationChip already surfaces citation.snippet only as a chip title tooltip (line 54) — the modal is the gap. Multiline snippets come from Dynamous ingest building '{heading}\\\\n\\\\n{text}' (ingest/dynamous.py:114). ChatArea.tsx renders <CitationModal> at line 788 and routes Dynamous to lesson_url before the modal opens. docs/adr/ does not exist (docs/agents/domain.md: convention dormant); the atlas decision register (docs/atlas/register/DECISION_REGISTER.md) has no entry touching the citation modal — DFE-015 (unit floor split factory/backend/frontend) is the only tangentially relevant decision and is covered by the ratchet invariant. docs/PROGRAMME_ACTIVATION.md records the owner-approved two-item programme (item 1 transcript = this issue; item 2 keyboard focus = follow-up that must not be pre-implemented). No new dependencies declared in the contract, so no manifest/lockfile planning is needed.\"\n}\n"},"design.json":{"sha256":"99b36c5db369baa75ff465a153bc63f8cfd3eb502537bd4a967aa7098beaf6f1","text":"{\"ac_mapping\":{\"AC-1\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"],\"AC-2\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"],\"AC-3\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"],\"AC-4\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"],\"AC-5\":[\"app/frontend/src/components/CitationModal.tsx#CitationModal\"]},\"allowed_new_files\":[],\"context_sha256\":\"ccacfb28a0c3ed5c9f499837918e7313e4d7083311bae533ba9a210cbe7cff43\",\"contract_sha256\":\"040339e6c8844316bd17e867184bf439956d70c3b23b12de884a0de50b5abca0\",\"data_flows\":[\"Citation.snippet (api.ts:53; populated by rag/tools.py:211 from db/repository.py snippet column, multiline via ingest/dynamous.py:114 '{heading}\\\\n\\\\n{text}') -> CitationModal trim guard -> 'Transcript Excerpt' heading + pre-wrap excerpt below the