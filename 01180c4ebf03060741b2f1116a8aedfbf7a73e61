onents/Sidebar.tsx\",\"app/frontend/src/components/VideoExplorer.tsx\",\"app/frontend/src/hooks/useAdminVideos.test.ts\",\"app/frontend/src/hooks/useAdminVideos.ts\",\"app/frontend/src/hooks/useConversations.test.ts\",\"app/frontend/src/hooks/useConversations.ts\",\"app/frontend/src/hooks/useMessages.ts\",\"app/frontend/src/hooks/useStreamingResponse.ts\",\"app/frontend/src/lib/api.ts\",\"app/frontend/src/lib/exportMarkdown.test.ts\",\"app/frontend/src/lib/exportMarkdown.ts\",\"app/frontend/src/pages/AdminVideos.tsx\",\"docs/PROGRAMME_ACTIVATION.md\"],\"version\":\"1.0\"}\n"},"architecture-governor.raw.json":{"sha256":"f37bb5835c6baa059d6b3c2f4aa7c83126cfe92d2bb3918d7d830bd9e8552882","text":"{\n  \"version\": \"1.0\",\n  \"decision\": \"proceed\",\n  \"convergence\": \"neutral\",\n  \"principles\": [\n    \"ARCH-BACKEND-BOUNDARIES\",\n    \"ARCH-DEEP-MODULES\",\n    \"ARCH-FRONTEND-BOUNDARIES\"\n  ],\n  \"migrations\": [\n    \"MIG-DB-REPOSITORY-SPLIT\",\n    \"MIG-FRONTEND-LARGE-COMPONENTS\",\n    \"MIG-RAG-TOOLS-SPLIT\"\n  ],\n  \"debts\": [\n    \"DEBT-CHAT-AREA\",\n    \"DEBT-DB-REPOSITORY\",\n    \"DEBT-RAG-TOOLS\",\n    \"DEBT-SIDEBAR\"\n  ],\n  \"rationale\": [\n    \"Seam is named and testable: every AC maps to the rendered CitationModal, exercised through render and screen queries with no reach into internals.\",\n    \"Behaviour sits behind the existing two-prop interface: the trim guard, pre-wrap excerpt and placement stay inside the component; ChatArea and Message callers are unchanged.\",\n    \"Interface stays small: no new props, exports, hooks, components or dependencies; formatTimestamp keeps its exported signature and location because Message.tsx imports it.\",\n    \"Extends an existing deep module instead of adding a parallel one: no new file and no duplication of Message's verbatim-text rendering path.\",\n    \"No layer-direction violations: the only import edge (Citation type from frontend-lib) already exists and is allowed for frontend-components.\",\n    \"No no-growth hotspot is touched: planned_files is CitationModal.tsx only, which carries no debt tag; ChatArea, Sidebar, repository.py and tools.py appear as read-only evidence, not change targets.\",\n    \"No active migration is worked against: the MIG-DB-REPOSITORY-SPLIT, MIG-RAG-TOOLS-SPLIT and MIG-FRONTEND-LARGE-COMPONENTS paths are outside planned_files.\",\n    \"Evidence claims verified in code: Citation.snippet exists (api.ts:53), is emitted by the RAG layer (rag/tools.py:211), is multiline from Dynamous ingest (ingest/dynamous.py:114), and Dynamous citations bypass the modal via ChatArea.handleCitationClick (ChatArea.tsx:443-458).\",\n    \"The negative test at CitationModal.test.tsx:35-41 is correctly identified as the expected-RED inversion target authored only by the acceptance worker, and every preservation test maps to real current behavior of the component.\",\n    \"AC-2's pre-wrap style assertion is the right observable: jsdom textContent retains newlines even when breaks visually collapse, so the inline whiteSpace check is the honest seam-level proof.\",\n    \"Multi-ticket horizon: the additive below-player diff leaves a clean base for programme item 2 (focus entry/restoration) on the same component without pre-implementing that work.\",\n    \"Convergence is neutral by design: the change neither creates coupling nor improves separation; it is a minimal in-place feature render reusing the codebase's existing verbatim-text idiom, which is the correct posture for the first of two sequenced items.\"\n  ],\n  \"required_changes\": [],\n  \"notes\": \"Verified against the worktree: CitationModal.tsx matches the contract's line references (content column with overflow-y-auto at line 89, Escape/backdrop/scroll-lock effects at lines 39-53, embed/external URL construction at lines 30-36, Video-unavailable fallbacks at lines 91-103). CitationModal.test.tsx:35-41 is the pinned absence test as described; the existing suite covers iframe src, external link, Escape, backdrop, close button, scroll lock and all three unavailable-URL fallbacks, so the guard ACs are already testable through the seam. Message.tsx:202 confirms the whiteSpace:'pre-wrap' idiom the design reuses. No new dependencies, no backend/API/type/state changes, and no protected-lane files in planned_files. The layout-squeeze and E2E-shape risks named in the contract are real but mitigated: the content column already scrolls, the change is additive below the player, and AC-1 keeps asserting the player iframe is present in the same render. Implementation should not add focus handling, truncation logic or backend snippet shaping — those are programme item 2 or out of scope. Deep-module check: a reader can understand the modal from its two-prop interface, and every acceptance criterion can be proven through that interface alone.\"\n}\n"},"context.enriched.json":{"sha256":"9aa2225dc6f7db9014a29f2ebbd13b9147732839cc9e25fa07cc44dca3597295","text":"{\"adrs\":[],\"callers\":[\"app/frontend/src/components/ChatArea.tsx#ChatArea\",\"app/frontend/src/components/Message.tsx#citationChip\",\"app/frontend/src/components/Message.tsx#SourceCitations\",\"[derived] app/frontend/src/App.tsx\",\"[derived] app/frontend/src/components/ChatArea.tsx\",\"[derived] app/frontend/src/components/CitationModal.tsx\",\"[derived] app/frontend/src/components/Message.tsx\",\"[derived] app/frontend/src/components/Sidebar.tsx\",\"[derived] app/frontend/src/components/VideoExplorer.tsx\",\"[derived] app/frontend/src/hooks/useAdminVideos.ts\",\"[derived] app/frontend/src/hooks/useConversations.ts\",\"[derived] app/frontend/src/hooks/useMessages.ts\",\"[derived] app/frontend/src/hooks/useStreamingResponse.ts\",\"[derived] app/frontend/src/lib/exportMarkdown.ts\",\"[derived] app/frontend/src/pages/AdminVideos.tsx\"],\"contract_sha256\":\"040339e6c8844316bd17e867184bf439956d70c3b23b12de884a0de50b5abca0\",\"deterministic_impact\":{\"callers\":[\"app/frontend/src/App.tsx\",\"app/fronte