{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dark-factory.local/task-contract.schema.json",
  "title": "Dark Factory Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "issue_type",
    "problem",
    "acceptance_criteria",
    "test_seam",
    "ambiguities",
    "invariants",
    "out_of_scope",
    "likely_paths",
    "symbols",
    "risk"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "issue": {"type": "integer", "minimum": 1},
    "issue_type": {"enum": ["bug", "feature", "enhancement", "refactor", "chore", "documentation"]},
    "problem": {"type": "string", "minLength": 12},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "behavior"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[1-9][0-9]*$"},
          "behavior": {"type": "string", "minLength": 8}
        }
      }
    },
    "test_seam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path_hint", "command", "expected_red"],
      "properties": {
        "kind": {"enum": ["unit", "integration", "e2e", "static", "docs"]},
        "path_hint": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 3},
        "expected_red": {"type": "string", "minLength": 3}
      }
    },
    "ambiguities": {"type": "array", "maxItems": 0},
    "invariants": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "likely_paths": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}},
    "symbols": {"type": "array", "maxItems": 30, "items": {"type": "string", "minLength": 1}},
    "risk": {"enum": ["low", "medium", "high"]}
  }
}
