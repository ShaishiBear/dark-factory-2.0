s/useStreamingResponse\"],\"planned_files\":[\"app/frontend/src/__tests__/ChatArea-first-send-strictmode.test.tsx\",\"app/frontend/src/hooks/useStreamingResponse.ts\"],\"public_interfaces\":[\"useStreamingResponse(conversationId: string | null) -> { streamingContent: string; streamingSources: Citation[]; streamingStatus: StreamingStatus | null; isStreaming: boolean; startStream: (conversationId: string, userMessage: string, onComplete: (result: StreamResult) => void) => Promise<void>; abortStream: () => void }\"],\"seams\":[\"app/frontend/src/hooks/useStreamingResponse.ts#useStreamingResponse (conversationId reset effect)\",\"app/frontend/src/hooks/useStreamingResponse.ts#startStream\",\"app/frontend/src/components/ChatArea.tsx#handleSend\"],\"version\":\"1.0\"}\n"},"design.raw.json":{"sha256":"2339196964f34dbc062b6501dc923248a9ac8ca74742f95ab656f050df6b3014","text":"{\n  \"version\": \"1.0\",\n  \"modules\": [\n    \"app/frontend/src/hooks/useStreamingResponse\"\n  ],\n  \"seams\": [\n    \"app/frontend/src/hooks/useStreamingResponse.ts#useStreamingResponse (conversationId reset effect)\",\n    \"app/frontend/src/hooks/useStreamingResponse.ts#startStream\",\n    \"app/frontend/src/components/ChatArea.tsx#handleSend\"\n  ],\n  \"public_interfaces\": [\n    \"useStreamingResponse(conversationId: string | null) -> { streamingContent: string; streamingSources: Citation[]; streamingStatus: StreamingStatus | null; isStreaming: boolean; startStream: (conversationId: string, userMessage: string, onComplete: (result: StreamResult) => void) => Promise<void>; abortStream: () => void }\"\n  ],\n  \"invariants\": [\n    \"The SSE wire format is unchanged: event: sources / event: status payloads, JSON-encoded token data, and data: [DONE] all parse exactly as today.\",\n    \"src/lib/api.ts, the backend, and src/main.tsx (the React.StrictMode wrapper) are not modified.\",\n    \"The reset still aborts and clears all streaming state (isStreaming false, streamingContent '', streamingSources [], streamingStatus null) whenever the conversation id genuinely changes, including a change to null.\",\n    \"The very first effect run for a conversation id (previous-id ref uninitialized, including StrictMode's second mount pass with the same id) is not treated as a change and never aborts an in-flight stream.\",\n    \"startStream still installs the AbortController synchronously before its first await, and the stop button's abortStream still aborts the in-flight stream on demand.\",\n    \"An intentional abort (user stop or a real navigation away) stays silent: the AbortError swallow branch in ChatArea.handleSend still produces no toast and no inline error.\",\n    \"Existing green suites remain green, notably the conversationId reset suite in app/frontend/src/hooks/useStreamingResponse.test.ts (reset on change and on change to null) and the #244 mid-stream-error suite.\"\n  ],\n  \"data_flows\": [\n    \"location.state.initialMessage -> ChatArea send-on-mount effect -> ChatArea#handleSend -> useStreamingResponse#startStream -> fetch(SSE body, AbortController signal) -> onComplete(fullText, sources) -> assistant message appended to message list\",\n    \"conversationId genuinely changes (conv-a -> conv-b, or -> null) -> useStreamingResponse conversationId reset effect -> abort old AbortController + reset isStreaming/streamingContent/streamingSources/streamingStatus\",\n    \"StrictMode mount-effect re-run (same conversationId) -> reset effect sees previous id equal to current -> no-op -> first-message stream survives and 'Stop response' stays visible\",\n    \"ChatInput stop click (aria-label 'Stop response') -> useStreamingResponse#abortStream -> fetch rejects with AbortError -> silent return in ChatArea#handleSend\"\n  ],\n  \"ac_mapping\": {\n    \"AC-1\": [\n      \"app/frontend/src/hooks/useStreamingResponse.ts#useStreamingResponse (conversationId reset effect)\"\n    ],\n    \"AC-2\": [\n      \"app/frontend/src/components/ChatArea.tsx#handleSend\",\n      \"app/frontend/src/hooks/useStreamingResponse.ts#startStream\"\n    ],\n    \"AC-3\": [\n      \"app/frontend/src/hooks/useStreamingResponse.ts#useStreamingResponse (conversationId reset effect)\"\n    ]\n  },\n  \"planned_files\": [\n    \"app/frontend/src/hooks/useStreamingResponse.ts\",\n    \"app/frontend/src/__tests__/ChatArea-first-send-strictmode.test.tsx\"\n  ],\n  \"allowed_new_files\": [\n    \"app/frontend/src/__tests__/ChatArea-first-send-strictmode.test.tsx\"\n  ],\n  \"notes\": \"Design: a previous-id ref inside useStreamingResponse (the contract's first-listed option). The reset effect body gains a guard: it performs the abort+clear only when the ref holds a previous value AND that value !== conversationId; the ref is updated to the current id on every run (sentinel for 'no previous value yet' must be distinguishable from null, e.g. undefined, so changes to null still reset). This moves zero behaviour between modules — the hook's public interface is byte-for-byte unchanged, only its effect's firing condition deepens. Chosen over moving the reset into startStream because the kept-green conversationId reset suite (useStreamingResponse.test.ts:462-538) asserts reset via rerender({convId}) on a live hook instance with no new startStream call, which a send-path reset would break; chosen over any ChatArea-side fix because the abort lives in the hook and ChatArea must not learn the hook's internals (deep module). Route topology (App.tsx) makes this correct for AC-3: /c/a -> /c/b re-renders the same ChatArea instance (prop change, hook persists, prev-id ref fires), while / <-> /c/<id> remounts ChatArea fresh (ref uninitialized, first run is not-a-change) and ChatArea unmount on / -> /logout-style exits is unchanged behaviour. Single production file changes: app/frontend/src/hooks/useStreamingResponse.ts. Tests: one new file app/frontend/src/__tests__/ChatArea-first-send-strictmode.test.tsx covering AC-1 (render ChatArea under React.StrictMode + MemoryRouter initialEntries [{pathname:'/c/conv-1', state:{initialMessage}}] with the REAL useStreamingResponse hook; global fetch mock honours init.signal — abort listener rejecting with DOMException('The operation was aborted.', 'AbortError') — and returns a gated ReadableStream SSE body; FIRST assertion is findByRole('button', { name: 'Stop response' }) so main prints the pinned substring 'Unable to find an accessible element with the role \\\"button\\\" and name \\\"Stop response\\\"'; also assert the first request's signal.aborted === false while streaming) and AC-2 (release the gate -> token events -> data: [DONE] -> assistant text via findByText, no inline error, addToast not called with an error). Mocks in the new file: useToast, useAuth, and useMessages — the useMessages mock must back setMessages with real React useState so the functional updater in handleSend's onComplete actually appends and the persisted assistant message renders; react-router-dom is used for real via MemoryRouter (no useNavigate mock needed since the mount is already at /c/<id>, so no createConversation leg is exercised — global fetch only serves the messages POST). Stub Element.prototype.scrollIntoView; ResizeObserver is absent in jsdom and already guarded. AC-3 needs no new test: it is guarded by the existing reset suite (change and change-to-null) which must stay green; optionally the new file may add a hook-level StrictMode wrapper case asserting no abort on the double mount pass, in the same test file. Ceiling note: the parallel reset pattern in useMessages.ts keeps its own StrictMode exposure (double-fetch of conversation on mount is idempotent and out of scope per the contract).\"\n}\n"},"frontier.json":{"sha256":"1abae9f49674fbfdc956078ca44e4b83fce75fe5649dc191e828bd64be8a044e","text":"{\"accepted\":true,\"blockers\":[],\"issue\":103,\"ready\":true,\"ticket_sha256\":\"5c635861372bbcd5723fa13c00b09dbabec6f23db6bbfb02c4fc3b3045774f69\",\"version\":\"1.0\"}\n"},"issue-frontier.json":{"sha256":"36f703731dcb2afd759a5b1462bbcf164d9689103cef633fb0d72e8be5a5eb3e","text":"{\"blockers\":[],\"fetched_at\":\"2026-09-06T23:53:20Z\",\"issue\":{\"body\":\"## Bug\\n\\nThe first message sent from the landing page never streams in the browser when the app runs under React StrictMode (the Vite dev server, which the factory's browser journey uses). The request is sent, the backend streams a full answer, and the page shows neither the \\\"Stop response\\\" state nor the answer, with no error.\\n\\n## Evidence (main-regression run 33963509318 on main f0ec074, harness/e2e.py journey)\\n\\n- `app-process.log`: `POST /api/conversations/<id>/messages 200 OK`, then `stream_chat round=1 ... round=3 finish_reason=stop content_deltas=6` — the backend produced the answer.\\n- `stream-states.jsonl` (a snapshot every 0.5 s for 87 s): `stop_button` never true; no assistant text beyond the user's own bubble.\\n- Final snapshot and `page.html`: the user's question, the \\\"Send message\\\" button, no assistant message, no inline error. Browser console and error log empty. The harness-side probe of the same route through the same frontend origin received the tokens (`E2E_STREAM_PROBE status=200 content_type=text/event-stream events=6 tokens=5 done=true`), so the route and proxy are fine; the page is what drops the stream.\\n\\n## Mechanism\\n\\n`app/frontend/src/hooks/useStreamingResponse.ts` has an effect keyed on `conversationId` that aborts `streamAbortRef.current` and resets `isStreaming`, `streamingContent`, `streamingSources`, `streamingStatus`. The first send goes: `ChatArea.handleSend` on `/` creates the conversation and navigates to `/c/<id>` with `state.initialMessage`; `ConversationPage` mounts a fresh `ChatArea`; its effect calls `handleSend(initialMessage)` → `startStream` sets `streamAbortRef.current` and starts the fetch. React 18 StrictMode then re-runs mount effects once: the reset effect runs a second time, now with `streamAbortRef.current` set, aborts the stream and clears the streaming state. The abort is treated as intentional (\\\"no error toast\\\"), so nothing is shown. Production serves the built bundle, where StrictMode does not re-run effects, which is why this has not been reported by users.\\n\\n## Expected\\n\\nA stream started on the current conversation must survive StrictMode's effect re-run: the reset must only fire when the conversation id actually changes from a previous value (track the previous id in a ref, or reset in the send path instead of an effect). The \\\"Stop response\\\" state must be visible while a first message streams, and the answer must render when it completes.\\n\\n## Acceptance\\n\\n- A Vitest test that renders the first-send flow under `React.StrictMode` with a mocked `fetch` (createConversation → id; messages → a readable SSE body) and asserts the stream is not aborted, \\\"Stop response\\\" appears while streaming, and the assistant text renders after `[DONE]`. The test must fail on current main.\\n- The existing behaviour on a real conversation switch (navigating from `/c/a` to `/c/b` mid-stream aborts the old stream) is kept and tested.\\n- No change to the SSE format, `src/lib/api.ts`, or the backend.\\n\",\"labels\":[{\"color\":\"5319E7\",\"description\":\"Dark Factory control state\",\"id\":\"LA_kwDOT-6Wzs8AAAACyJrubg\",\"name\":\"factory:accepted\"},{\"color\":\"d93f0b\",\"description\":\"Dark Factory triage label\",\"id\":\"LA_kwDOT-6Wzs8AAAACzxETTg\",\"name\":\"priority:high\"},{\"color\":\"d73a4a\",\"description\":\"Dark Factory triage label\",\"id\":\"LA_kwDOT-6Wzs8AAAACzxEUlw\",\"name\":\"type:bug\"}],\"number\":103,\"state\":\"OPEN\",\"title\":\"fix(chat): first message's stream is aborted by StrictMode's effect re-run, nothing renders\",\"updatedAt\":\"2026-09-06T23:52:00Z\",\"url\":\"https://github.com/ShaishiBear/dark-factory-2.0/issues/103\"},\"version\":\"1.0\"}\n"},"issue.json":{"sha256":"b660084bbeac83d85bf1d8e99a0bf38090f9c674f2f828e5fc11de0cdd801001","text":"{\"body\":\"## Bug\\n\\nThe first message sent from the landing page never streams in the browser when the app runs under React StrictMode (the Vite dev server, which the factory's browser journey uses). The request is sent, the backend streams a full answer, and the page shows neither the \\\"Stop response\\\" state nor the answer, with no error.\\n\\n## Evidence (main-regression run 33963509318 on main f0ec074, harness/e2e.py journey)\\n\\n- `app-process.log`: `POST /api/conversations/<id>/messages 200 OK`, then `stream_chat round=1 ... round=3 finish_reason=stop content_deltas=6` — the backend produced the answer.\\n- `stream-states.jsonl` (a snapshot every 0.5 s for 87 s): `stop_button` never true; no assistant text beyond the user's own bubble.\\n- Final snapshot and `page.html`: the user's question, the \\\"Send message\\\" button, no assistant message, no inline error. Browser console and error log empty. The harness-side probe of the same route through the same frontend origin received the tokens (`E2E_STREAM_PROBE status=200 content_type=text/event-stream events=6 tokens=5 done=true`), so the route and proxy are fine; the page is what drops the stream.\\n\\n## Mechanism\\n\\n`app/frontend/src/hooks/useStreamingResponse.ts` has an effect keyed on `conversationId` that aborts `streamAbortRef.current` and resets `isStreaming`, `streamingContent`, `streamingSources`, `streamingStatus`. The first send goes: `ChatArea.handleSend` on `/` creates the conversation and navigates to `/c/<id>` with `state.initialMessage`; `ConversationPage` mounts a fresh `ChatArea`; its effect calls `handleSend(initialMessage)` → `startStream` sets `streamAbortRef.current` and starts the fetch. React 18 StrictMode then re-runs mount effects once: the reset effect runs a second time, now with `streamAbortRef.current` set, aborts the stream and clears the streaming state. The abort is treated as intentional (\\\"no error toast\\\"), so nothing is shown. Production serves the built bundle, where StrictMode does not re-run effects, which is why this has not been reported by users.\\n\\n## Expected\\n\\nA stream started on the current conversation must survive StrictMode's effect re-run: the reset must only fire when the conversation id actually changes from a previous value (track the previous id in a ref, or reset in the send path instead of an effect). The \\\"Stop response\\\" state must be visible while a first message streams, and the answer must render when it completes.\\n\\n## Acceptance\\n\\n- A Vitest test that renders the first-send flow under `React.StrictMode` with a mocked `fetch` (createConversation → id; messages → a readable SSE body) and asserts the stream is not aborted, \\\"Stop response\\\" appears while streaming, and the assistant text renders after `[DONE]`. The test must fail on current main.\\n- The existing behaviour on a real conversation switch (navigating from `/c/a` to `/c/b` mid-stream aborts the old stream) is kept and tested.\\n- No change to the SSE format, `src/lib/api.ts`, or the backend.\\n\",\"labels\":[{\"color\":\"5319E7\",\"description\":\"Dark Factory control state\",\"id\":\"LA_kwDOT-6Wzs8AAAACyJrubg\",\"name\":\"factory:accepted\"},{\"color\":\"d93f0b\",\"description\":\"Dark Factory triage label\",\"id\":\"LA_kwDOT-6Wzs8AAAACzxETTg\",\"name\":\"priority:high\"},{\"color\":\"d73a4a\",\"description\":\"Dark Factory triage label\",\"id\":\"LA_kwDOT-6Wzs8AAAACzxEUlw\",\"name\":\"type:bug\"}],\"number\":103,\"state\":\"OPEN\",\"title\":\"fix(chat): first message's stream is aborted by StrictMode's effect re-run, nothing renders\",\"updatedAt\":\"2026-09-06T23:52:00Z\",\"url\":\"https://github.com/ShaishiBear/dark-factory-2.0/issues/103\"}\n"},"repro-deferred.json":{"sha256":"abc15a8df2c1e650de147a0098a1bbba0a7151ffc3c687f7771bc5f2ec507bfd","text":"{\n  \"version\": \"1.0\",\n  \"reason\": \"The abort only fires when React StrictMode re-runs mount effects, and no existing test renders any component under React.StrictMode (grep of app/frontend/src finds StrictMode only in src/main.tsx): useStreamingResponse.test.ts drives the real hook with plain renderHook (effects run once, so the conversationId reset effect never re-fires), and the ChatArea tests mock useStreamingResponse out entirely, so every existing command passes on the unchanged tree while the browser journey's first-send symptom is uncovered. The failing StrictMode acceptance test demanded by the issue does not exist yet, so the red loop is deferred to it.\",\n  \"seam\": \"app/frontend/src/hooks/useStreamingResponse.ts (conversationId reset effect that aborts streamAbortRef), exercised through app/frontend/src/components/ChatArea.tsx rendered under React.StrictMode with location.state.initialMessage\",\n  \"expected_symptom\": \"Unable to find an accessible element with the role \\\"button\\\" and name \\\"Stop response\\\"\"\n}\n"},"repro-observed.json":{"sha256":"3a20b76fddb335487b46f8b12d1ffa96f3ae6d5e8b9fb7c5590d2d54d000a37b","text":"{\"expected_symptom\":\"Unable to find an accessible element with the role \\\"button\\\" and name \\\"Stop response\\\"\",\"mode\":\"deferred\",\"observed_in_red\":null,\"reason\":\"The abort only fires when React StrictMode re-runs mount effects, and no existing test renders any component under React.StrictMode (grep of app/frontend/src finds StrictMode only in src/main.tsx): useStreamingResponse.test.ts drives the real hook with plain renderHook (effects run once, so the conversationId reset effect never re-fires), and the ChatArea tests mock useStreamingResponse out entirely, so every existing command passes on the unchanged tree while the browser journey's first-send symptom is uncovered. The failing StrictMode acceptance test demanded by the issue does not exist yet, so the red loop is deferred to it.\",\"seam\":\"app/frontend/src/hooks/useStreamingResponse.ts (conversationId reset effect that aborts streamAbortRef), exercised through app/frontend/src/components/ChatArea.tsx rendered under React.StrictMode with location.state.initialMessage\",\"version\":\"1.0\"}\n"},"task-contract.json":{"sha256":"d1954b999c4924965b9d23df7432fb94500f7038a64bb1160122b1b99c6b0673","text":"{\"ambiguities\":[],\"behaviors\":[{\"given\":\"ChatArea is mounted under React.StrictMode + MemoryRouter at /c/<id> with location.state.initialMessage (the first-send flow), and global fetch is mocked to honour init.signal and return 200 with a readable SSE body held open (a gated stream that can be released later)\",\"id\":\"AC-1\",\"seam\":\"app/frontend/src/hooks/useStreamingResponse.ts (conversationId reset effect that aborts streamAbortRef), exercised through app/frontend/src/components/ChatArea.tsx rendered under React.StrictMode with location.state.initialMessage\",\"then\":\"the in-flight stream is NOT aborted: the first request's signal remains unaborted and the stream keeps running; while streaming, a button with accessible name \\\"Stop response\\\" is present (isStreaming true, streaming bubble visible). On current main this assertion fails, printing exactly the pinned red symptom: Unable to find an accessible element with the role \\\"button\\\" and name \\\"Stop response\\\"\",\"when\":\"the mount effects run — the send-on-mount effect dispatches handleSend(initialMessage) -> startStream, which installs the AbortController synchronously before its first await — and React StrictMode re-runs the mount effects once while the stream is still open\"},{\"given\":\"the same first-send StrictMode setup as AC-1, with the gated SSE body released so it emits its token events and then data: [DONE]\",\"id\":\"AC-2\",\"seam\":\"app/frontend/src/components/ChatArea.tsx#handleSend (onComplete appends the persisted assistant message), driven by the real app/frontend/src/hooks/useStreamingResponse.ts under React.StrictMode\",\"then\":\"startStream's onComplete fires, the assistant message carrying the full streamed text renders in the message list, and no inline error or error toast appears (the AbortError silent-swallow branch in ChatArea.handleSend is not hit)\",\"when\":\"the stream completes normally\"},{\"given\":\"a stream is in flight on conversation 'conv-a' through the real useStreamingResponse hook (fetch pending), as when a user navigates /c/a -> /c/b mid-stream\",\"id\":\"AC-3\",\"kind\":\"guard\",\"seam\":\"app/frontend/src/hooks/useStreamingResponse.ts#useStreamingResponse (conversationId reset effect)\",\"then\":\"the old stream's AbortController is aborted and streaming state resets — isStreaming false, streamingContent '', streamingSources [], streamingStatus null — unchanged from today's kept behaviour (existing reset suite in useStreamingResponse.test.ts must stay green)\",\"when\":\"the conversationId prop/argument genuinely changes to a different value ('conv-b', or null)\"}],\"dependencies\":[],\"invariants\":[\"The SSE wire format is unchanged: event: sources / event: status payloads, JSON-encoded token data, and data: [DONE] all parse exactly as today.\",\"src/lib/api.ts, the backend, and src/main.tsx (the React.StrictMode wrapper) are not modified.\",\"The reset still aborts and clears all streaming state whenever the conversation id genuinely changes, including a change to null.\",\"startStream still installs the AbortController synchronously before its first await, and the stop button's abortStream still aborts the in-flight stream on demand.\",\"An intentional abort (user stop or a real navigation away) stays silent: the AbortError swallow branch in ChatArea.handleSend still produces no toast and no inline error.\",\"Existing green suites remain green, notably the conversationId reset suite in app/frontend/src/hooks/useStreamingResponse.test.ts (reset on change and on change to null) and the #244 mid-stream-error suite.\"],\"issue\":{\"number\":103,\"title\":\"fix(chat): first message's stream is aborted by StrictMode's effect re-run, nothing renders\"},\"out_of_scope\":[\"Backend, SSE format, src/lib/api.ts, and src/main.tsx — the issue's acceptance explicitly forbids changing them.\",\"The harness/e2e.py browser journey — that file does not exist in this repository (it belongs to the factory's main-regression pipeline); component-level Vitest coverage is the contract here.\",\"The stale-closure read of streamingStatus?.tool at useStreamingResponse.ts:166 (affects only a console.warn, no user-visible behaviour).\",\"The parallel reset-on-conversationId pattern in useMessages.ts.\",\"Production bundle behaviour — StrictMode does not double-invoke effects in the built bundle, so no prod-only code paths are touched.\"],\"risks\":[\"The pinned red symptom depends on React 18 StrictMode double-invocation semantics inside jsdom (both effect passes flush before any re-render, so the stop button never mounts on main). The acceptance test must make findByRole('button', { name: 'Stop response' }) the FIRST assertion so the pinned substring is what main prints; the fallback red symptom, if a flash between passes were possible, is the first fetch call's signal.aborted === true after the stream ends.\",\"The mocked fetch must honour init.signal (register an abort listener that rejects with DOMException('The operation was aborted.', 'AbortError')); a signal-ignoring mock would let the stream complete and weaken the red, and a plain Error rejection would surface the inline-error path instead of the reported silent symptom.\",\"The fix's previous-id sentinel must treat the very first mount (no previous value) as not-a-change and still handle changes to null; a naive 'reset exactly once' implementation would break the AC-3 guard or the existing reset suite.\",\"The new StrictMode test must render the real useStreamingResponse hook (the abort is only observable there); the existing ChatArea test file mocks the hook out entirely, so a separate test file is the clean way to avoid mock leakage. Mock only useMessages/useAuth/useToast if needed.\",\"The red loop is deferred: it has never been executed on this tree. The RED checkpoint must confirm the pinned substring 'Unable to find an accessible element with the role \\\"button\\\" and name \\\"Stop response\\\"' appears in the failing test's output.\"],\"summary\":\"Make the conversationId-keyed reset effect in useStreamingResponse abort and clear streaming state only when the conversation id genuinely changes (previous-id ref, or reset moved into the send path), so the first message's stream survives React StrictMode's mount-effect re-run under the Vite dev server: the \\\"Stop response\\\" state is visible while the first message streams and the assistant answer renders when the stream completes; a real conversation switch mid-stream still aborts the old stream.\",\"version\":\"2.0\"}\n"},"task-contract.raw.json":{"sha256":"b263de2b27bec3ec2ec98e67397c06c67cdcf2417ef80d8e67c9349c94fd9b92","text":"{\n  \"version\": \"2.0\",\n  \"issue\": {\n    \"number\": 103,\n    \"title\": \"fix(chat): first message's stream is aborted by StrictMode's effect re-run, nothing renders\"\n  },\n  \"summary\": \"Make the conversationId-keyed reset effect in useStreamingResponse abort and clear streaming state only when the conversation id genuinely changes (previous-id ref, or reset moved into the send path), so the first message's stream survives React StrictMode's mount-effect re-run under the Vite dev server: the \\\"Stop response\\\" state is visible while the first message streams and the assistant answer renders when the stream completes; a real conversation switch mid-stream still aborts the old stream.\",\n  \"behaviors\": [\n    {\n      \"id\": \"AC-1\",\n      \"given\": \"ChatArea is mounted under React.StrictMode + MemoryRouter at /c/<id> with location.state.initialMessage (the first-send flow), and global fetch is mocked to honour init.signal and return 200 with a readable SSE body held open (a gated stream that can be released later)\",\n      \"when\": \"the mount effects run — the send-on-mount effect dispatches handleSend(initialMessage) -> startStream, which installs the AbortController synchronously before its first await — and React StrictMode re-runs the mount effects once while the stream is still open\",\n      \"then\": \"the in-flight stream is NOT aborted: the first request's signal remains unaborted and the stream keeps running; while streaming, a button with accessible name \\\"Stop response\\\" is present (isStreaming true, streaming bubble visible). On current main this assertion fails, printing exactly the pinned red symptom: Unable to find an accessible element with the role \\\"button\\\" and name \\\"Stop response\\\"\",\n      \"seam\": \"app/frontend/src/hooks/useStreamingResponse.ts (conversationId reset effect that aborts streamAbortRef), exercised through app/frontend/src/components/ChatArea.tsx rendered under React.StrictMode with location.state.initialMessage\"\n    },\n    {\n      \"id\": \"AC-2\",\n      \"given\": \"the same first-send StrictMode setup as AC-1, with the gated SSE body released so it emits its token events and then data: [DONE]\",\n      \"when\": \"the stream completes normally\",\n      \"then\": \"startStream's onComplete fires, the assistant message carrying the full streamed text renders in the message list, and no inline error or error toast appears (the AbortError silent-swallow branch in ChatArea.handleSend is not hit)\",\n      \"seam\": \"app/frontend/src/components/ChatArea.tsx#handleSend (onComplete appends the persisted assistant message), driven by the real app/frontend/src/hooks/useStreamingResponse.ts under React.StrictMode\"\n    },\n    {\n      \"id\": \"AC-3\",\n      \"kind\": \"guard\",\n      \"given\": \"a stream is in flight on conversation 'conv-a' through the real useStreamingResponse hook (fetch pending), as when a user navigates /c/a -> /c/b mid-stream\",\n      \"when\": \"the conversationId prop/argument genuinely changes to a different value ('conv-b', or null)\",\n      \"then\": \"the old stream's AbortController is aborted and streaming state resets — isStreaming false, streamingContent '', streamingSources [], streamingStatus null — unchanged from today's kept behaviour (existing reset suite in useStreamingResponse.test.ts must stay green)\",\n      \"seam\": \"app/frontend/src/hooks/useStreamingResponse.ts#useStreamingResponse (conversationId reset effect)\"\n    }\n  ],\n  \"invariants\": [\n    \"The SSE wire format is unchanged: event: sources / event: status payloads, JSON-encoded token data, and data: [DONE] all parse exactly as today.\",\n    \"src/lib/api.ts, the backend, and src/main.tsx (the React.StrictMode wrapper) are not modified.\",\n    \"The reset still aborts and clears all streaming state whenever the conversation id genuinely changes, including a change to null.\",\n    \"startStream still installs the AbortController synchronously before its first await, and the stop button's abortStream still aborts the in-flight stream on demand.\",\n    \"An intentional abort (user stop or a real navigation away) stays silent: the AbortError swallow branch in ChatArea.handleSend still produces no toast and no inline error.\",\n    \"Existing green suites remain green, notably the conversationId reset suite in app/frontend/src/hooks/useStreamingResponse.test.ts (reset on change and on change to null) and the #244 mid-stream-error suite.\"\n  ],\n  \"out_of_scope\": [\n    \"Backend, SSE format, src/lib/api.ts, and src/main.tsx — the issue's acceptance explicitly forbids changing them.\",\n    \"The harness/e2e.py browser journey — that file does not exist in this repository (it belongs to the factory's main-regression pipeline); component-level Vitest coverage is the contract here.\",\n    \"The stale-closure read of streamingStatus?.tool at useStreamingResponse.ts:166 (affects only a console.warn, no user-visible behaviour).\",\n    \"The parallel reset-on-conversationId pattern in useMessages.ts.\",\n    \"Production bundle behaviour — StrictMode does not double-invoke effects in the built bundle, so no prod-only code paths are touched.\"\n  ],\n  \"risks\": [\n    \"The pinned red symptom depends on React 18 StrictMode double-invocation semantics inside jsdom (both effect passes flush before any re-render, so the stop button never mounts on main). The acceptance test must make findByRole('button', { name: 'Stop response' }) the FIRST assertion so the pinned substring is what main prints; the fallback red symptom, if a flash between passes were possible, is the first fetch call's signal.aborted === true after the stream ends.\",\n    \"The mocked fetch must honour init.signal (register an abort listener that rejects with DOMException('The operation was aborted.', 'AbortError')); a signal-ignoring mock would let the stream complete and weaken the red, and a plain Error rejection would surface the inline-error path instead of the reported silent symptom.\",\n    \"The fix's previous-id sentinel must treat the very first mount (no previous value) as not-a-change and still handle changes to null; a naive 'reset exactly once' implementation would break the AC-3 guard or the existing reset suite.\",\n    \"The new StrictMode test must render the real useStreamingResponse hook (the abort is only observable there); the existing ChatArea test file mocks the hook out entirely, so a separate test file is the clean way to avoid mock leakage. Mock only useMessages/useAuth/useToast if needed.\",\n    \"The red loop is deferred: it has never been executed on this tree. The RED checkpoint must confirm the pinned substring 'Unable to find an accessible element with the role \\\"button\\\" and name \\\"Stop response\\\"' appears in the failing test's output.\"\n  ],\n  \"ambiguities\": [],\n  \"dependencies\": []\n}\n"},"ticket.json":{"sha256":"5c635861372bbcd5723fa13c00b09dbabec6f23db6bbfb02c4fc3b3045774f69","text":"{\"acceptance\":[\"AC-1\",\"AC-2\",\"AC-3\"],\"body_sha256\":\"722375436cddc68b1680d71b7738845de55fa8429db8165cdd6a0732e9f7cbc6\",\"contract_sha256\":\"d1954b999c4924965b9d23df7432fb94500f7038a64bb1160122b1b99c6b0673\",\"issue\":103,\"parent\":null,\"test_seams\":{\"AC-1\":\"app/frontend/src/hooks/useStreamingResponse.ts (conversationId reset effect that aborts streamAbortRef), exercised through app/frontend/src/components/ChatArea.tsx rendered under React.StrictMode with location.state.initialMessage\",\"AC-2\":\"app/frontend/src/components/ChatArea.tsx#handleSend (onComplete appends the persisted assistant message), driven by the real app/frontend/src/hooks/useStreamingResponse.ts under React.StrictMode\",\"AC-3\":\"app/frontend/src/hooks/useStreamingResponse.ts#useStreamingResponse (conversationId reset effect)\"},\"title\":\"fix(chat): first message's stream is aborted by StrictMode's effect re-run, nothing renders\",\"version\":\"1.0\"}\n"}},"base_sha":"6a7f8c6fec3a15d736e47a7799d3a8f4f034e1a2","issue":103,"issue_sha256":"da4893d12872366907269fac1742f051871e4f073085e5624a4d51b611ff7ab5","kernel_commit":"6a7f8c6fec3a15d736e47a7799d3a8f4f034e1a2","note_ref":"refs/notes/dark-factory-carry","policy_sha256":"f15bf0292510bbcd56d6b1d3e28bfb46f63b70d3360448db122b5c3ad5ddfde0","run_id":"issue-103-a2-8cbcb18225","version":"1.0","written_at":"2026-09-07T00:19:19Z"}
