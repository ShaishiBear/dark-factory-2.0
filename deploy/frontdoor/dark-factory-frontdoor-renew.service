[Unit]
Description=Renew Dark Factory Front Door IP certificate
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The timer supplies jitter. Certbot's additional sleep can exceed this service's timeout.
ExecStart=/opt/dark-factory-frontdoor/certbot/bin/certbot renew --cert-name dark-factory-frontdoor --no-random-sleep-on-renew --quiet --deploy-hook "/usr/bin/systemctl reload dark-factory-frontdoor-proxy.service"
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
