d/src/components/Message.test.tsx","[derived] app/frontend/src/components/Sidebar.test.tsx","[derived] app/frontend/src/hooks/useAdminVideos.test.ts","[derived] app/frontend/src/hooks/useConversations.test.ts","[derived] app/frontend/src/lib/exportMarkdown.test.ts"],"version":"1.0"},"sha256":"af1169c7b19325bf27349095597da3bfce41ad4feadf694449c9653ce7851368","source":"context.json"},"contract":{"content":{"ambiguities":[],"behaviors":[{"given":"a YouTube citation (no source_type) whose video_url is 'not-a-url' and whose snippet is 'Relevant text' (start_seconds 10, end_seconds 20)","id":"AC-1","seam":"app/frontend/src/lib/exportMarkdown.ts#formatCitation (YouTube fallback: unparseable video_url), exercised via app/frontend/src/lib/exportMarkdown.test.ts","then":"the returned string contains '> \"Relevant text\"' on its own line. On the unchanged tree this acceptance test is RED: formatCitation returns '<title> (timestamp link unavailable) — 0:10–0:20' with no blockquote, so a presence assertion (e.g. toContain('> \"Relevant text\"')) fails and the failure output exhibits the promised symptom '(timestamp link unavailable) — 0:10–0:20' verbatim","when":"formatCitation(citation) is called"},{"given":"the same citation: YouTube, video_url 'not-a-url', non-empty snippet","id":"AC-2","seam":"app/frontend/src/lib/exportMarkdown.ts#formatCitation (YouTube fallback: unparseable video_url), exercised via app/frontend/src/lib/exportMarkdown.test.ts","then":"the returned string starts with '- ' and still contains '(timestamp link unavailable)' and '0:10–0:20'. On the unchanged tree the returned string starts with the video title instead of '- ', so the assertion is RED","when":"formatCitation(citation) is called"},{"given":"a citation with source_type 'dynamous', an empty lesson_url (''), a non-empty snippet, and video_url ''","id":"AC-3","seam":"app/frontend/src/lib/exportMarkdown.ts#formatCitation (Dynamous fallback: empty lesson_url), exercised via app/frontend/src/lib/exportMarkdown.test.ts","then":"the returned string starts with '- ', contains no '](' (plain title text, no markdown link), and still contains its '> \"<snippet>\"' blockquote on its own line. On the unchanged tree the blockquote is already present on this path but the string starts with the video title instead of '- ', so the starts-with assertion is RED","when":"formatCitation(citation) is called"},{"given":"a YouTube citation whose video_url is a valid URL with no v parameter (e.g. 'https://www.youtube.com/') and whose snippet is non-empty","id":"AC-4","seam":"app/frontend/src/lib/exportMarkdown.ts#formatCitation (YouTube fallback: missing v parameter), exercised via app/frontend/src/lib/exportMarkdown.test.ts","then":"the returned string starts with '- ', contains '(timestamp link unavailable)' and its '> \"<snippet>\"' blockquote on its own line, and contains no '[title](https://www.youtube.com/watch?v=' link. On the unchanged tree the returned value contains the symptom '(timestamp link unavailable) — 0:10–0:20' with neither the marker nor the blockquote, so the test is RED","when":"formatCitation(citation) is called"}],"dependencies":[],"invariants":["All 27 existing cases in app/frontend/src/lib/exportMarkdown.test.ts keep passing; acceptance tests are added to that same file and no existing case is rewritten.","The empty-snippet guard remains the first statement of formatCitation: empty, whitespace-only, or missing snippet still returns '', so formatSources emits no entry (and no stray '- ') for such citations.","The invalid-video_url path keeps calling console.warn with the exact message '[exportMarkdown] Skipping timestamp link — invalid video_url: \"not-a-url\"' and keeps the video title as plain text (no '[title](' wrapper).","The missing-v path keeps emitting no 'watch?v=' link and keeps '(timestamp link unavailable)'; the Dynamous empty-lesson_url path keeps emitting no ']('.","The '- ' marker prefixes the whole returned entry (the string starts with '- '), so entries joined by formatSources with newlines render as one bullet per citation instead of merging into the previous list item.","The snippet blockquote sits on its own line using the codebase's existing two-space-indent convention '  > \"<snippet>\"', matching both link paths.","The valid-URL and valid-lesson_url branches keep their exact current shape: '- [title](url) — <range>' followed by a newline and the two-space-indented '  > \"<snippet>\"' line; formatTimestamp and the M:SS–M:SS en-dash range format are untouched.","No new or version-changed npm packages; frontend-only change (Vitest suite plus the one production module)."],"issue":{"number":49,"title":"fix(export): markdown export drops the transcript snippet when a citation URL cannot be parsed"},"out_of_scope":["Backend, schema, and dependency changes (no new or version-changed packages).","Production files other than app/frontend/src/lib/exportMarkdown.ts — in particular CitationModal.tsx, Message.tsx, ChatArea.tsx, and Sidebar.tsx.","The valid-URL and valid-lesson_url branches of formatCitation.","formatTimestamp.","The export header and the filename slug in exportConversationAsMarkdown.","Refactoring the duplicated console.warn fallback blocks or fixing the formatSources stray-blank-line quirk for empty-snippet citations — separate issues, not this PR."],"risks":["RED provability depends on assertion style: the AC-1 acceptance test must use a presence assertion (e.g. toContain('> \"Relevant text\"')) so Vitest prints the received value, whose tail contains the promised symptom '(timestamp link unavailable) — 0:10–0:20'; purely boolean assertions (e.g. expect(result.startsWith('- ')).toBe(true)) would fail without printing the symptom.","The acceptance fixtures' video_title is not fixed by the issue (its Background implies 'Test Video'; the existing suite uses 'Test Video Title'); the promised symptom '(timestamp link unavailable) — 0:10–0:20' is title-agnostic, so assertions should avoid hard-coding the full received string.","Unicode dashes matter: the timestamp range uses an en dash (U+2013) as in '0:10–0:20', and the fallback line an em dash (U+2014) between '(timestamp link unavailable)' and the range; acceptance tests must copy these characters exactly or presence assertions will fail even on the fixed tree.","The fix is tightly constrained by existing fallback assertions (no '[title](' on invalid URL, no 'watch?v=' on missing v, no '](' on Dynamous empty lesson_url, exact console.warn message); 'upgrading' the fallbacks into link-bearing entries breaks the existing suite.","Adding the '- ' marker before the empty-snippet guard would make formatSources emit stray '- ' entries for empty-snippet citations; the guard must stay the first statement."],"summary":"Repair the three non-link fallback branches of formatCitation in app/frontend/src/lib/exportMarkdown.ts so every exported citation entry uses the canonical shape the two link paths already emit: a leading '- ' list marker and a quoted-snippet blockquote line ('  > \"<snippet>\"') after the title and timestamp range. The YouTube fallbacks (unparseable video_url, missing v parameter) currently return '<title> (timestamp link unavailable) — 0:10–0:20' and silently drop the transcript snippet; the Dynamous fallback with an empty lesson_url keeps the snippet but lacks the '- ' marker, so formatSources' newline join merges the entry into the previous list item when rendered. MISSION.md's 'RAG responses with rich citations' bar requires every cited chunk to keep its transcript snippet in the export. Only app/frontend/src/lib/exportMarkdown.ts changes in production; acceptance tests are added to the existing app/frontend/src/lib/exportMarkdown.test.ts.","version":"2.0"},"sha256":"042f029cc1b66809d78dbb501d888ab1894ad282e0da9b9f495715fd21715232","source":"task-contract.json"},"design":{"content":{"ac_mapping":{"AC-1":["app/frontend/src/lib/exportMarkdown.ts#formatCitation"],"AC-2":["app/frontend/src/lib/exportMarkdown.ts#formatCitation"],"AC-3":["app/frontend/src/lib/exportMarkdown.ts#formatCitation"],"AC-4":["app/frontend/src/lib/exportMarkdown.ts#formatCitation"]},"allowed_new_files":[],"context_sha256":"af1169c7b19325bf27349095597da3bfce41ad4feadf694449c9653ce7851368","contract_sha256":"042f029cc1b66809d78dbb501d888ab1894ad282e0da9b9f495715fd21715232","data_flows":["Citation[] -> formatSources -> one formatCitation call per citation -> entries joined with '\\n' under '**Sources:**'","citation with unparseable or v-less video_url -> formatCitation fallback -> '- <title> (timestamp link unavailable) — <range>' + newline + '  > \"<snippet>\"'","dynamous citation with empty lesson_url -> formatCitation fallback -> '- <title> — <range>' + newline + '  > \"<snippet>\"'","citation with empty/whitespace/missing snippet -> formatCitation first-statement guard -> '' (no entry emitted)"],"invariants":["All 27 existing cases in app/frontend/src/lib/exportMarkdown.test.ts keep passing; new acceptance tests are added to that same file without rewriting existing cases.","The empty-snippet guard remains the first statement of formatCitation: empty, whitespace-only, or missing snippet still returns '', so formatSources emits no entry (and no stray '- ') for such citations.","The invalid-video_url path keeps calling console.warn with the exact message '[exportMarkdown] Skipping timestamp link — invalid video_url: \"not-a-url\"' and keeps the video title as plain text (no '[title](' wrapper).","The missing-v path keeps emitting no 'watch?v=' link and keeps '(timestamp link unavailable)'; the Dynamous empty-lesson_url path keeps emitting no ']('.","Every formatCitation return starts with '- ' so formatSources' newline join renders one bullet per citation.","The snippet blockquote sits on its own line as the two-space-indented '  > \"<snippet>\"', matching both link paths.","The valid-URL and valid-lesson_url branches, formatTimestamp, the M:SS–M:SS en-dash range, the export header, and