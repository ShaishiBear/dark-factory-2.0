{
  "version": "1.0",
  "repository": "ShaishiBear/dark-factory-2.0",
  "default_branch": "main",
  "provider": {
    "id": "claude-cli",
    "binary": "claude",
    "model": "z-ai/glm-5.3-flash",
    "architecture_model": "deepseek/deepseek-v4-pro-0813",
    "timeout_seconds": 2700,
    "_timeout_seconds": "The global maximum wall for one CLI process. Each role runs under its own wall, worker_policy.stage_timeout_seconds(role) = ceil(max_turns * 45 s/turn * 1.5), and every one of those must fit under this maximum (assert_caps_fit_timeout); 2700 covers the 2025 s a 30-turn role needs. Raised from 1200, which sat exactly on a 30-turn worker's budget at the measured 40.4 s/turn (D-054).",
    "transient_retries": 2,
    "idle_timeout_seconds": 420,
    "_idle_timeout_seconds": "A process that prints no stream-json event for this long is killed as hung, recorded, and retried once (D-054)."
  },
  "runtime": {
    "max_attempts": 2,
    "active_lease_ttl_seconds": 21600,
    "legacy_lease_ttl_seconds": 86400,
    "work_root": "/tmp/dark-factory"
  },
  "labels": {
    "accepted": "factory:accepted",
    "rejected": "factory:rejected",
    "rate_limited": "factory:rate-limited",
    "in_progress": "factory:in-progress",
    "needs_review": "factory:needs-review",
    "needs_fix": "factory:needs-fix",
    "needs_human": "factory:needs-human",
    "stop": "factory:stop"
  },
  "prompts": {
    "triage": ".factory/prompts/triage.md",
    "plan": ".factory/prompts/plan.md",
    "investigate": ".factory/prompts/investigate.md",
    "contract": ".factory/prompts/contract.md",
    "context": ".factory/prompts/context.md",
    "architecture": ".factory/prompts/architecture.md",
    "test_author": ".factory/prompts/test-author.md",
    "implement": ".factory/prompts/implement.md",
    "repair": ".factory/prompts/repair.md",
    "conformance": ".factory/prompts/conformance.md",
    "holdout": ".factory/prompts/holdout.md",
    "review-spec": ".factory/prompts/review-spec.md",
    "review-standards": ".factory/prompts/review-standards.md"
  },
  "validation": {
    "quick_command": [
      "python",
      "harness/ci.py",
      "--quick"
    ]
  }
}
